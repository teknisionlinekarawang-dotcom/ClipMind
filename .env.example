# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Transkripsi Python (faster-whisper) ---
# Port & host server ClipMind (app). Default 3000.
PORT="3000"
HOST="0.0.0.0"
# USE_PY_TRANSCRIBE=false untuk memakai transkripsi AI (Gemini) seperti semula.
USE_PY_TRANSCRIBE="true"
# TRANSCRIBER_URL harus menunjuk ke CLIPMIND_TRANSCRIBER_PORT di bawah.
TRANSCRIBER_URL="http://127.0.0.1:8790"
# Konfigurasi service Python (dibaca oleh transcriber/app.py):
CLIPMIND_WHISPER_MODEL="mobiuslabsgmbh/faster-whisper-large-v3-turbo"
CLIPMIND_WHISPER_MODEL_DIR=""
CLIPMIND_WHISPER_DEVICE="cpu"
CLIPMIND_WHISPER_COMPUTE="int8"
CLIPMIND_FFMPEG=""
CLIPMIND_TRANSCRIBER_PORT="8790"

# --- AI penyempurnaan ejaan transkrip (opsional, jalan di Python) ---
# Aktif otomatis bila BASE_URL + API_KEY diisi. Isi API_KEY sendiri (jangan lewat chat).
CLIPMIND_LLM_BASE_URL=""
CLIPMIND_LLM_API_KEY=""
CLIPMIND_LLM_MODEL="auto"
CLIPMIND_LLM_REFINE="auto"
